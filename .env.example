# Copy this file to .env and adjust the values.

# PostgreSQL connection string. Matches the database in compose.yaml.
DATABASE_URL=postgres://tervi:tervi-dev-password@localhost:5432/tervi?sslmode=disable

# Address the server listens on. Optional; defaults to 127.0.0.1:8080.
SERVER_ADDR=127.0.0.1:8080

# Address used in approval links.
TERVI_PUBLIC_URL=http://localhost:8080

# Set to on to expose the API docs at /docs; keep off outside development.
TERVI_API_DOCS=off
